diff --git a/target/linux/mediatek/dts/mt7981b-clt-r30b1.dts b/target/linux/mediatek/dts/mt7981b-clt-r30b1.dts
new file mode 100644
index 0000000000..7844bf1fa7
--- /dev/null
+++ b/target/linux/mediatek/dts/mt7981b-clt-r30b1.dts
@@ -0,0 +1,123 @@
+/dts-v1/;
+
+#include "mt7981.dtsi"
+
+/ {
+    model = "CLT R30B1";
+    compatible = "clt,r30b1", "mediatek,mt7981";
+
+    aliases {
+        led-boot = &led_status_green;
+        led-failsafe = &led_status_red;
+        led-running = &led_status_green;
+        led-upgrade = &led_status_red;
+    };
+
+    chosen {
+        bootargs-append = "earlycon";
+    };
+
+    memory@40000000 {
+        device_type = "memory";
+        reg = <0x40000000 0x10000000>; /* 256MB */
+    };
+
+    gpio-keys {
+        compatible = "gpio-keys";
+
+        reset {
+            label = "reset";
+            gpios = <&pio 9 GPIO_ACTIVE_LOW>; /* Adjust if wrong */
+            linux,code = <KEY_RESTART>;
+        };
+
+        mesh {
+            label = "mesh";
+            gpios = <&pio 10 GPIO_ACTIVE_LOW>; /* Adjust if wrong */
+            linux,code = <KEY_WPS_BUTTON>;
+        };
+    };
+
+    gpio-leds {
+        compatible = "gpio-leds";
+
+        led_status_green: status_green {
+            label = "green:status";
+            gpios = <&pio 11 GPIO_ACTIVE_LOW>; /* Adjust if wrong */
+            default-state = "off";
+        };
+
+        led_status_red: status_red {
+            label = "red:status";
+            gpios = <&pio 12 GPIO_ACTIVE_LOW>; /* Adjust if wrong */
+            default-state = "off";
+        };
+    };
+};
+
+&spi0 {
+    status = "okay";
+
+    flash@0 {
+        compatible = "jedec,spi-nor";
+        reg = <0>;
+        spi-max-frequency = <80000000>;
+
+        partitions {
+            compatible = "fixed-partitions";
+            #address-cells = <1>;
+            #size-cells = <1>;
+
+            partition@0 {
+                label = "BL2";
+                reg = <0x0 0x100000>;
+                read-only;
+            };
+
+            partition@100000 {
+                label = "u-boot-env";
+                reg = <0x100000 0x80000>;
+            };
+
+            partition@180000 {
+                label = "Factory";
+                reg = <0x180000 0x200000>;
+                read-only;
+            };
+
+            partition@380000 {
+                label = "FIP";
+                reg = <0x380000 0x200000>;
+                read-only;
+            };
+
+            partition@580000 {
+                label = "ubi";
+                reg = <0x580000 0x7000000>;
+            };
+        };
+    };
+};
+
+&eth {
+    status = "okay";
+
+    gmac0: mac@0 {
+        compatible = "mediatek,eth-mac";
+        reg = <0>;
+        phy-mode = "2500base-x";
+        fixed-link {
+            speed = <2500>;
+            full-duplex;
+        };
+    };
+};
+
+&switch0 {
+    status = "okay";
+};
+
+&wmac {
+    status = "okay";
+};
+
diff --git a/target/linux/mediatek/filogic/base-files/etc/board.d/01_leds b/target/linux/mediatek/filogic/base-files/etc/board.d/01_leds
