+
 		return 0
 		;;
 	*)
@@ -208,6 +222,7 @@ platform_copy_config() {
 	bananapi,bpi-r3-mini|\
 	bananapi,bpi-r4|\
 	bananapi,bpi-r4-poe|\
+        clt,r30b1 |\
 	cmcc,rax3000m)
 		if [ "$CI_METHOD" = "emmc" ]; then
 			emmc_copy_config
diff --git a/target/linux/mediatek/image/filogic.mk b/target/linux/mediatek/image/filogic.mk
index 60f45a73e6..40d1692ac2 100644
--- a/target/linux/mediatek/image/filogic.mk
+++ b/target/linux/mediatek/image/filogic.mk
@@ -500,6 +500,28 @@ define Device/cetron_ct3003
 endef
 TARGET_DEVICES += cetron_ct3003
 
+define Device/clt_r30b1
+  DEVICE_VENDOR := MediaTek
+  DEVICE_MODEL := CLT R30B1
+  DEVICE_DTS := mt7981b-clt-r30b1
+  DEVICE_DTS_DIR := ../dts
+  SUPPORTED_DEVICES := clt,r30b1
+  DEVICE_PACKAGES := kmod-mt7986-firmware mt7981-wo-firmware
+  UBINIZE_OPTS := -E 5
+  BLOCKSIZE := 128k
+  PAGESIZE := 2048
+  IMAGE_SIZE := 114688k
+  KERNEL = kernel-bin | lzma | \
+    fit lzma $(KDIR)/image-$(firstword $(DEVICE_DTS)).dtb
+  KERNEL_INITRAMFS = kernel-bin | lzma | \
+    fit lzma $(KDIR)/image-$(firstword $(DEVICE_DTS)).dtb with-initrd
+  IMAGES := factory.bin sysupgrade.bin
+  IMAGE/factory.bin := append-ubi | check-size $$$$(IMAGE_SIZE)
+  IMAGE/sysupgrade.bin := sysupgrade-tar | append-metadata
+  KERNEL_IN_UBI := 1
+endef
+TARGET_DEVICES += clt_r30b1
+
 define Device/cmcc_a10-stock
   DEVICE_VENDOR := CMCC
   DEVICE_MODEL := A10 (stock layout)
